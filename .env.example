# Server-side settings for online flight booking (api/flights.js → server/).
# Copy to .env.local for `npm run dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deploys.
# Never commit real values, and never prefix these with VITE_ (that would
# put them in the browser bundle).

# ---- TBO (Tek Travels) Air API -------------------------------------------
# Use the "API Login" username/password from TBO's email, NOT the B2B portal login.
TBO_USERNAME=
TBO_PASSWORD=
# staging (default) or live. Live also needs the URLs TBO gives you at sign-off.
TBO_ENV=staging
# TBO_CLIENT_ID=ApiIntegrationNew
# TBO_SHARED_URL=https://Sharedapi.tektravels.com/SharedData.svc/rest
# TBO_AIR_URL=https://api.tektravels.com/BookingEngineService_Air/AirService.svc/rest
# TBO_AIR_BOOK_URL=   (only if TBO gives a separate booking URL for live)
# The server's public IP, sent as EndUserIp when logging in.
# TBO_END_USER_IP=
# Keep full Search responses in the logs while certifying (they are large).
# TBO_LOG_SEARCH=full
# Live TBO only accepts whitelisted static IPs. On Vercel, send TBO traffic
# through a static-IP proxy (e.g. QuotaGuard Static / Fixie):
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@proxy-host:port

# ---- Database (Neon Postgres via the Vercel Marketplace) -------------------
# Leave empty for local dev: an in-process Postgres (PGlite) in .data/ is used.
# After setting it, run: npm run db:migrate
DATABASE_URL=

# ---- Razorpay ---------------------------------------------------------------
# Test keys: https://dashboard.razorpay.com/app/keys (toggle Test Mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Webhooks → add https://www.protoursandtravelsolutions.com/api/flights/razorpay/webhook
# with events order.paid and payment.captured, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Certification/testing only: book on TBO staging without a card. Ignored when TBO_ENV=live.
ALLOW_FAKE_PAYMENTS=false

# ---- Business settings --------------------------------------------------------
# Agency markup as a percentage of the airline fare (0–50). Shown to customers as "Service fee".
FLIGHT_MARKUP_PERCENT=0
# Optional fixed fee per date change, in rupees (on top of the airline's charge and fare difference).
FLIGHT_CHANGE_FEE=0
# Password for the staff console at /flights/staff — use a long random one.
STAFF_PASSWORD=
# Protects /api/flights/cron (finishes stuck bookings, polls cancellations,
# deletes old personal data). Vercel Cron sends it automatically; an external
# cron (e.g. cron-job.org every 2–5 min) can call
#   https://www.protoursandtravelsolutions.com/api/flights/cron?key=<CRON_SECRET>
CRON_SECRET=
